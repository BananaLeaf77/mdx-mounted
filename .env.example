# RATE LIMITING CONFIGURATION (PRODUCTION-READY)
# ========================================================================
RATE_LIMIT_ENABLED=
# Global rate limits (applies to all endpoints unless overridden)
RATE_LIMIT_REQUESTS_PER_WINDOW=
RATE_LIMIT_WINDOW_DURATION=

# Auth-specific rate limits (stricter for security)
RATE_LIMIT_AUTH_REQUESTS=
RATE_LIMIT_AUTH_WINDOW=

# Login rate limit (very strict to prevent brute force)
# Configured in code: 5 requests per 5 minutes

# Password operations (strict to prevent abuse)
# Configured in code: 3 requests per 15 minutes

# OTP operations (strict to prevent spam)
# Configured in code: 5 requests per 15 minutes

# Booking operations (prevent spam booking)
# Configured in code: 10 requests per minute

# ========================================================================
# DATABASE CONFIGURATION
# ========================================================================
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=
DB_SSLMODE=

# ========================================================================
# CORS CONFIGURATION
# ========================================================================
# For production, replace with your actual domain
ALLOW_ORIGINS=


# URL DETAILS / DOMAIN FOR PUSH NOTIFICATION
TARGETED_DOMAIN = 

# ========================================================================
# JWT CONFIGURATION
# ========================================================================
# IMPORTANT: This is a secure 32+ character secret
# Generate a new one with: openssl rand -base64 32
JWT_SECRET=

# ========================================================================
# REDIS CONFIGURATION
# ========================================================================
REDIS_ADDR=
# Optional: Add password for production Redis
REDIS_PASSWORD=
REDIS_TLS=
# ========================================================================
# APPLICATION CONFIGURATION
# ========================================================================
APP_NAME=
PORT=
APP_ENV=productionn
APP_API_RETURN_LANG=IDN

# ========================================================================
# SMTP CONFIGURATION (Gmail)
# ========================================================================
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ========================================================================
# ADMIN ACCOUNT (AUTO-GENERATED ON FIRST RUN)
# ========================================================================
ADMIN_PHONE=
ADMIN_NAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_GENDER=

# Support phone
ADMIN_SUPPORT_PHONE=

# NOTIFICATION QR CODE TARGET EMAIL
QR_CODE_EMAIL_RECEIVER=

# ========================================================================
# OTP CONFIGURATION
# ========================================================================
OTP_TIME=

# ========================================================================
# DEFAULT IMAGES / CDN Credential
# ========================================================================
CLOUDINARY_API_SECRET=
DEFAULT_PROFILE_IMAGE=
# ========================================================================

XENDIT_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=
XENDIT_WEBHOOK_TOKEN=
TZ=Asia/Makassar
# PRODUCTION SECURITY NO
# ========================================================================
# 1. JWT_SECRET: MUST be at least 32 characters (generate with: openssl rand -base64 32)
# 2. DB_PASSWORD: Use a strong database password
# 3. ALLOW_ORIGINS: Only whitelist your production domains
# 4. SMTP_PASS: Use app-specific password, not your main password
# 5. REDIS_PASSWORD: Always set a password for Redis in production
# 6. ADMIN_PASSWORD: Change default admin password immediately
# 7. Enable SSL/TLS in production (DB_SSLMODE=require)


# TEACHER COMISSION AND REGISTRATION FEE DEFAULT (BASED ON CLIENT AGREEMENT)
TEACHER_DEFAULT_COMISSION=
DEFAULT_REGISTRATION_FEE=